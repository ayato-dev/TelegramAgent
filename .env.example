# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma-separated numeric Telegram user IDs that may use the bot.
# Groups are allowed only when one of these users adds the bot.
ALLOWED_USER_IDS=111111111,222222222

# --- AI providers ---
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-haiku-5-5
# History is compacted once a request exceeds this many input tokens (API minimum 50000).
COMPACTION_TRIGGER_TOKENS=100000
MAX_OUTPUT_TOKENS=16000
DEFAULT_EFFORT=medium
WEB_SEARCH_MAX_USES=5

GROQ_API_KEY=gsk_replace-me
WHISPER_MODEL=whisper-large-v3

# --- Storage ---
POSTGRES_USER=tgagent
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=tgagent
DATABASE_URL=postgresql+asyncpg://tgagent:replace-me@postgres:5432/tgagent

# --- Misc ---
TIMEZONE=Europe/Moscow
CHAT_LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO
