# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma-separated numeric Telegram user IDs that may use the bot.
# Groups are allowed only when one of these users adds the bot.
ALLOWED_USER_IDS=111111111,222222222
# What the bot answers people outside the list (empty = stay silent).
ACCESS_DENIED_TEXT=Доступ к боту закрыт.

# --- AI providers: set any of these keys, at least one ---
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Groq: free gpt-oss-120b, and Whisper for voice messages: https://console.groq.com/keys
GROQ_API_KEY=

# Model new chats start with, as provider:model-id. Empty = the cheapest model of the first
# provider with a key (in the order above). Users can switch models in /settings.
# anthropic:claude-haiku-5-5 | openai:gpt-6-luna | gemini:gemini-3.1-flash-lite
# deepseek:deepseek-flash | groq:openai/gpt-oss-120b
DEFAULT_MODEL=
# Context is compacted once a request exceeds this many input tokens (minimum 50000).
COMPACTION_TRIGGER_TOKENS=100000
MAX_OUTPUT_TOKENS=16000
DEFAULT_EFFORT=medium
# Claude only: web searches per answer.
WEB_SEARCH_MAX_USES=5

WHISPER_MODEL=whisper-large-v3
# Set true on paid plans. Free Groq allows 8K tokens per minute, so the bot keeps gpt-oss chats
# short; paid Groq lifts that and counts Groq (and Whisper) in /usage.
GROQ_PAID_TIER=false
# Paid Gemini adds Google Search and counts Gemini in /usage.
GEMINI_PAID_TIER=false

# --- Storage ---
# compose.yaml builds DATABASE_URL from these; keep the password URL-safe (letters, digits, - _).
POSTGRES_USER=tgagent
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=tgagent
# Only when running the bot outside Docker:
# DATABASE_URL=postgresql+asyncpg://tgagent:replace-me@localhost:5432/tgagent

# --- Misc ---
TIMEZONE=Europe/Moscow
CHAT_LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO
